# =====================================================================
#  JARVIS SUNUCU (.env) - VPS'te /opt/jarvis/jarvis-brain/.env
#  deploy/setup.sh bu dosyadan .env olusturur ve JARVIS_TOKEN'i uretir.
#  GERCEK DEGER YAZILMAMIS ORNEKTIR. .env git'e EKLENMEZ (chmod 600).
#  Not: systemd EnvironmentFile ayni satirda yorum desteklemez -> yorumlar ayri satirda.
# =====================================================================

# --- Zorunlu ---
# Google AI Studio anahtari: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Sunucu <-> istemci ortak gizli anahtar (en az 24 karakter). Uretmek icin:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=
# Yalnizca 127.0.0.1 ya da Tailscale IP'si (tailscale ip -4). 0.0.0.0 REDDEDILIR.
JARVIS_SERVER_BIND=127.0.0.1
JARVIS_SERVER_PORT=8765

# --- Kritik hata bildirimi (bos birakilirsa yalnizca loglanir) ---
# @BotFather ile bot olustur -> token; chat id icin bota yaz, sonra:
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Guvenilirlik ---
# Acilista tum modelleri gercek bir istekle test et (true onerilir)
JARVIS_MODEL_PROBE=true
# /command cevabi icin azami bekleme (sn)
JARVIS_COMMAND_TIMEOUT=90
# JSON log dosyasi (10 MB'ta doner, 10 dosya saklanir)
# JARVIS_SERVER_LOG=/opt/jarvis/jarvis-brain/data/logs/server.jsonl

# --- Modeller (varsayilanlar settings.py'de) ---
# GEMINI_MODEL=models/gemini-2.5-flash-native-audio-latest
# JARVIS_AGENTS_MODEL=gemini-flash-lite-latest

# --- Hafiza (VPS'e tasindi) ---
JARVIS_OBSIDIAN_VAULT=/opt/jarvis/hafiza
JARVIS_OBSIDIAN_SUBDIR=

# --- E-posta (sunucuda calisir; GONDERME her zaman istemciden onay ister) ---
# EMAIL_ADDRESS=
# EMAIL_APP_PASSWORD=

# --- Istemcide calisan parcalar: sunucuda KAPALI ---
JARVIS_ADB_ENABLED=false
JARVIS_WHATSAPP_ENABLED=false
WEBCAM_ENABLED=false

# --- Web konsolu + okul koprusu (ayni guvenli adrese baglanir) ---
JARVIS_WEB_PORT=8770
# Bos birakilirsa JARVIS_TOKEN kullanilir
JARVIS_WEB_TOKEN=
JARVIS_REMOTE_AUDIO_PORT=8771
# Bos birakilirsa JARVIS_TOKEN kullanilir
JARVIS_REMOTE_AUDIO_TOKEN=
# Onay bu surede gelmezse islem REDDEDILIR (asla otomatik onay yok)
JARVIS_REMOTE_CONFIRM_TIMEOUT=120
