# Google AI Studio API anahtari: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# OpenRouter API anahtari: https://openrouter.ai/keys
# agents/agents.json'daki "saglayici/model" bicimli modeller (orn. openrouter/free) icin.
# Bos birakilirsa bu ajanlar Gemini zincirine duser.
OPENROUTER_API_KEY=

# Claude API anahtari: https://console.anthropic.com/settings/keys
# agents/agents.json'daki "claude-*" modeller (yazilim ajanlari: kodcu, bilgisayar_op) icin.
# Bos birakilirsa bu ajanlar OpenRouter zincirine duser.
ANTHROPIC_API_KEY=
# Anahtar bir workspace'e bagli degilse zorunlu (wrkspc_...; Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=

# --- Telegram botu (araclar + otomatik yanit kolu) ---
# @BotFather -> /newbot -> token. Kendi chat id'n icin bota mesaj at, sonra
# https://api.telegram.org/bot<TOKEN>/getUpdates ciktisindaki "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
# Otomatik yanit YALNIZCA bu sohbetlere (virgulle; bos = TELEGRAM_DEFAULT_CHAT_ID)
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# TELEGRAM_AUTO_REPLY=true        # false => gelen mesajlar yalnizca sesli bildirilir

# --- Gmail API (OAuth 2.0) - doluysa IMAP/SMTP yerine kullanilir ---
# Google Cloud -> Gmail API -> OAuth istemcisi (Masaustu) JSON'u indir, sonra:
#   python scripts/gmail_auth.py
GMAIL_CREDENTIALS_FILE=           # bos = config/gmail_credentials.json
GMAIL_TOKEN_FILE=                 # bos = data/gmail_token.json

# --- Ulasim (Izmir) ---
# IZMIR_OPENAPI_TOKEN=            # canli otobus servisleri (openapi.izmir.bel.tr) icin Bearer token
# IZMIRIM_KART_NO=                # bakiye sayfasi acilirken soylenir

# --- Opsiyonel override'lar ---
# GEMINI_MODEL=models/gemini-2.5-flash-native-audio-latest
# JARVIS_VOICE=Puck
# Kisilik modlari (HUD sag alt: EKİPLER): FRIDAY ve ULTRON'un Gemini hazir sesleri
# JARVIS_FRIDAY_VOICE=Kore
# JARVIS_ULTRON_VOICE=Charon
# JARVIS_ULTRON_FX=true   # ULTRON sesine robotik/metalik efekt
# LOG_LEVEL=INFO
# WEBCAM_ENABLED=false   # ilk acilista kamera KAPALI; arayuzdeki kamera dugmesiyle acilir. true => acilista otomatik ac
# WEBCAM_INDEX=0
# JARVIS_SCREEN_ENABLED=true    # ekran gorusu (screen vision)
# JARVIS_SCREEN_MONITOR=1       # 1 = birincil ekran, 0 = tum ekranlar
# JARVIS_OPEN_VIA_SEARCH=true   # false => uygulamalari dogrudan ac (arama cubugu kullanma)
# JARVIS_TYPE_IN_BROWSER=true   # false => web sitesini dogrudan ac (adres cubuguna yazma)
# JARVIS_CONFIRM_CLOSE=true     # false => kapatma icin onay isteme
# JARVIS_ALWAYS_ON_TOP=true
# JARVIS_MINIMIZE_TO_TRAY=true
# JARVIS_STARTUP_SOUND=true     # acilista alkis sesi

# --- FounderOS ajan sistemi ---
# JARVIS_AGENTS_ENABLED=true
# JARVIS_AGENTS_MODEL=gemini-flash-lite-latest
# Model router (router/, config/models.yaml): ajan + model kararini yerel siniflandiriciyla
# milisaniyede verir; kararlar data/logs/routing.jsonl'e yazilir. false -> eski davranis
# (Conductor LLM + agents.json'daki sabit modeller).
# JARVIS_ROUTER_ENABLED=true
# JARVIS_AGENTS_AUTO_APPROVE=true   # human_assisted ajanlari otomatik onayla (UI onayi baglaninca false yap)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=service-role-veya-anon-key    # yoksa data/task_logs.jsonl'e yazar
# SUPABASE_TABLE=task_logs
# NTFY_TOPIC=jarvis-<benzersiz>              # yoksa bildirimler yalnizca loglanir
# NTFY_SERVER=https://ntfy.sh

# --- E-posta (IMAP okuma + SMTP gonderme) ---
# Gmail: hesabinda 2 Adimli Dogrulama ac -> myaccount.google.com/apppasswords
#        -> 16 haneli uygulama sifresini asagiya bosluksuz yaz
# EMAIL_ADDRESS=ornek@gmail.com
# EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# EMAIL_SENDER_NAME=Adin (JARVIS)
# EMAIL_IMAP_HOST=          # bos birak (gmail/outlook otomatik)
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=

# --- Acilis animasyonu ---
# orb = Zoey OS tarzi orb ortaya suzulerek gelir, 3d = 3B zirh, classic = halka animasyonu
# (orb ve 3d icin web3d/ derlenmis ve QtWebEngine kurulu olmali; 3B zirh F9 ile her zaman acilir)
# JARVIS_BOOT_STYLE=orb
# 3B acilistan sonra zirhin ekranda kalacagi sure (sn). 0 = Esc ya da "ARAYUZE GEC" bekler.
# JARVIS_BOOT_HOLD_S=3

# --- Icerik paneli (video / Wikipedia / belge / site JARVIS arayuzunun icinde acilir) ---
# "CV'mi ac" gibi isteklerde belge aranan ve acilmasina izin verilen klasorler (; ile ayir).
# Bos = Belgeler + Masaustu + Indirilenler. Yalnizca .pdf / .txt / .md acilir.
# JARVIS_DOCS_DIRS=C:\Users\ben\Documents;D:\Okul

# --- Yerel web konsolu (telefondan kontrol) ---
# JARVIS_WEB_CONSOLE=true
# JARVIS_WEB_PORT=8770
# JARVIS_WEB_BIND=0.0.0.0        # LAN erisimi; 127.0.0.1 = sadece bu PC
# JARVIS_WEB_TOKEN=gizli-anahtar # bos ise sadece localhost baglanabilir (LAN icin doldur)

# --- El Kontrolu + Kitaplik (/el; "Jarvis, el kontrolunu ac") ---
# Cevrimdisi: bir kez `python scripts/el_modeli_indir.py` (MediaPipe modelleri web/static/models/)
# JARVIS_USER_NAME=Sezai                  # yuz HUD etiketi ("SEZAI · TANINDI")
# JARVIS_VISION_MODEL=gemini-3.6-flash    # raf taramasi modeli (bos = ajan model zinciri)
# JARVIS_WELCOME_VOICE=tr-TR-AhmetNeural  # yuz kilidi karsilama sesi (edge-tts)
# JARVIS_WELCOME_TEXT=Yüz tanındı. Hoş geldiniz efendim, tam yetki verildi.
# JARVIS_CALIBRE_LIBRARY=C:\Users\sezai\Calibre Library   # bos = Calibre ayarindan bulunur

# --- Uzaktan sunucu modu (motor bu makinede, ses+kontrol baska bir bilgisayarda) ---
# Detayli kurulum: docs/remote_setup.md . "network" icin JARVIS_WEB_TOKEN VE
# JARVIS_REMOTE_AUDIO_TOKEN ikisi de DOLU olmali, yoksa run_server.py baslamayi reddeder.
# JARVIS_AUDIO_MODE=local            # "local" (bu PC'nin mikrofonu) | "network" (uzak istemci)
# JARVIS_REMOTE_AUDIO_PORT=8771
# JARVIS_REMOTE_AUDIO_TOKEN=gizli-anahtar-2
# JARVIS_REMOTE_CONFIRM_TIMEOUT=120  # web'den onay gelmezse bu sn sonra REDDEDILIR

# --- Proaktif / zamanlayici (core/scheduler_handler.py) ---
# SCHEDULER_ENABLED=true            # (eski adi JARVIS_SCHEDULER da gecerli)
# JARVIS_MORNING_BRIEFING=08:30     # sabah ozeti saati; "kapali" = devre disi (eski 09:00 brifing geri acilir)
# JARVIS_MORNING_CHANNELS=          # bos = hepsi | ornek: voice,telegram,whatsapp,ntfy
# JARVIS_HEALTH_INTERVAL_MIN=60     # sistem saglik kontrolu (dk); 0 = kapali
# JARVIS_HEALTH_CPU_ALERT=90        # % esikler - asilirsa kanallara uyari (6 saatte bir)
# JARVIS_HEALTH_MEM_ALERT=90
# JARVIS_HEALTH_DISK_ALERT=90

# --- Kod calistirma (DIKKAT: kabuk/python calistirir) ---
# JARVIS_CODE_EXEC=false

# --- Android ADB kontrol (Ultron modulu) ---
# JARVIS_ADB_ENABLED=true
# JARVIS_ADB_PATH=adb          # PATH'te degilse platform-tools\adb.exe tam yolu
# JARVIS_ADB_TCP_PORT=5555     # kablosuz ADB portu
# Acilista otomatik `adb connect` denenecek WiFi cihaz adresleri (virgulle):
# JARVIS_ADB_TCP_DEVICES=192.168.1.42,192.168.1.43:5555
# Telefon ekran kilidi PIN'i - tanimliysa "telefonu ac" kilidi otomatik acar
# (GIZLI - .env gitignore'da; JARVIS'e sesli "telefon sifresini kaydet ..." de dersen buraya yazilir)
# JARVIS_ADB_UNLOCK_PIN=1234

# --- GBrain kalici hafiza ---
# JARVIS_GBRAIN=true

# --- okul (BOTE Ders Merkezi) koprusu ---
# okul web uygulamasi web konsoluna baglanir; JARVIS ders/sinav/odev/program/GANO okur+yazar
# JARVIS_OKUL_ENABLED=true

# --- Obsidian kasa entegrasyonu ---
# Tanimliysa remember_note + kb_write + KONUSMALAR kasaya markdown yazilir
# JARVIS_OBSIDIAN_VAULT=C:\Users\KULLANICI\Documents\JARVIS Hafiza
# JARVIS_OBSIDIAN_SUBDIR=          # bos = kasa koku (JARVIS'e ozel kasa); "JARVIS" = paylasilan kasada alt klasor
# JARVIS_OBSIDIAN_LOG_CONVERSATIONS=true   # her konusma turunu Konusmalar/YYYY-MM-DD.md'ye ekle

# --- WhatsApp kolu (core/whatsapp_handler.py) ---
# Asil ayarlar config/whatsapp.json'da (gitignore'da). Buradaki override opsiyonel.
# JARVIS_WHATSAPP_ENABLED=false      # config'i gecersiz kilar (true = zorla ac)
# JARVIS_WHATSAPP_HEADLESS=false     # true => tarayici gorunmez (ilk QR icin false birak)

# --- Telefon web konsolu ---
# JARVIS_WEB_CONSOLE=true
# JARVIS_WEB_PORT=8770
# JARVIS_WEB_BIND=0.0.0.0
# JARVIS_WEB_TOKEN=uzun-gizli-anahtar     # LAN erisimi icin ZORUNLU
