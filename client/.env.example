# =====================================================================
#  CYRAEN ISTEMCI (.env) - PC'de cyraen-brain/client/.env
#  GERCEK DEGER YAZILMAMIS ORNEKTIR. Bu dosyayi client/.env olarak kopyalayip doldurun.
# =====================================================================

# Sunucunun Tailscale adi (MagicDNS, orn. cyraen-vps) ya da Tailscale IP'si
CYRAEN_SERVER_HOST=
CYRAEN_SERVER_PORT=8765
# Sunucudaki .env ile AYNI deger
CYRAEN_TOKEN=

# Bu istemcinin adi/turu (sunucu /health'te gorunur). Robot icin: CYRAEN_CLIENT_KIND=robot
CYRAEN_CLIENT_NAME=ev-pc
CYRAEN_CLIENT_KIND=desktop

# Hangi parcalar acik
# mikrofon -> sunucu, sunucu -> hoparlor
CYRAEN_CLIENT_AUDIO=true
# motor istedikce ekran/kamera karesi gonder
CYRAEN_CLIENT_VISION=true
# klavye/fare/uygulama/dosya/ADB eylemlerini yurut
CYRAEN_CLIENT_DESKTOP=true
# onay istekleri: dialog (Windows mesaj kutusu) | console | deny (hepsini reddet)
CYRAEN_CLIENT_CONFIRM=dialog

# Portlar / ayri tokenlar (bos = CYRAEN_TOKEN)
# CYRAEN_REMOTE_AUDIO_PORT=8771
# CYRAEN_REMOTE_AUDIO_TOKEN=
# CYRAEN_WEB_PORT=8770
# CYRAEN_WEB_TOKEN=
