# =====================================================================
#  JARVIS ISTEMCI (.env) - PC'de jarvis-brain/client/.env
#  GERCEK DEGER YAZILMAMIS ORNEKTIR. Bu dosyayi client/.env olarak kopyalayip doldurun.
# =====================================================================

# Sunucunun Tailscale adi (MagicDNS, orn. jarvis-vps) ya da Tailscale IP'si
JARVIS_SERVER_HOST=
JARVIS_SERVER_PORT=8765
# Sunucudaki .env ile AYNI deger
JARVIS_TOKEN=

# Bu istemcinin adi/turu (sunucu /health'te gorunur). Robot icin: JARVIS_CLIENT_KIND=robot
JARVIS_CLIENT_NAME=ev-pc
JARVIS_CLIENT_KIND=desktop

# Hangi parcalar acik
# mikrofon -> sunucu, sunucu -> hoparlor
JARVIS_CLIENT_AUDIO=true
# motor istedikce ekran/kamera karesi gonder
JARVIS_CLIENT_VISION=true
# klavye/fare/uygulama/dosya/ADB eylemlerini yurut
JARVIS_CLIENT_DESKTOP=true
# onay istekleri: dialog (Windows mesaj kutusu) | console | deny (hepsini reddet)
JARVIS_CLIENT_CONFIRM=dialog

# Portlar / ayri tokenlar (bos = JARVIS_TOKEN)
# JARVIS_REMOTE_AUDIO_PORT=8771
# JARVIS_REMOTE_AUDIO_TOKEN=
# JARVIS_WEB_PORT=8770
# JARVIS_WEB_TOKEN=
