# CYRAEN sunucusu (beyin) - systemd servisi
# Kurulum: sudo bash deploy/setup.sh   (bu dosyayi /etc/systemd/system/cyraen.service olarak kopyalar)
# Loglar : journalctl -u cyraen -f      (JSON log dosyasi: /opt/cyraen/cyraen-brain/data/logs/server.jsonl)

[Unit]
Description=CYRAEN sunucusu (beyin) - Gemini Live + ajanlar
Documentation=file:///opt/cyraen/cyraen-brain/deploy/README.md
# Uvicorn Tailscale IP'sine baglanir -> Tailscale ayaga kalkmadan baslamasin
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=cyraen
Group=cyraen
WorkingDirectory=/opt/cyraen/cyraen-brain
EnvironmentFile=/opt/cyraen/cyraen-brain/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
ExecStart=/opt/cyraen/venv/bin/python -m server

# 7/24: cokerse (veya Tailscale IP'si henuz yoksa) 5 sn sonra yeniden baslat
Restart=always
RestartSec=5
# SIGTERM -> sunucu motoru duzgunce kapatir; 30 sn icinde bitmezse zorla
KillSignal=SIGTERM
TimeoutStopSec=30

# --- sertlestirme ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/cyraen

[Install]
WantedBy=multi-user.target
